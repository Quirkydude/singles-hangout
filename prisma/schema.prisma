// Single's Hangout 2026 - registration portal data model
// Prisma ORM 7 (driver adapter based, generated client lives in src/generated/prisma)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

model Registration {
  id              String    @id @default(cuid())
  code            String    @unique
  fullName        String
  location        String
  isFacilitator   Boolean   @default(false)
  affiliation     String? // "Habitat Assembly", "Other COP Assembly", "Non-COP"
  role            String? // "Organizer", "Protocol Member", "Participant"
  phone           String    @unique
  age             Int
  gender          String?
  panelQuestion   String?
  smsStatus       SmsStatus @default(PENDING)
  smsError        String?
  smsSentAt       DateTime?
  attended        Boolean   @default(false)
  checkedInAt     DateTime?

  // Removed by an organizer: the row is kept so the phone number stays
  // taken (they cannot register again) and the spot is freed. Their code
  // is treated as invalid everywhere.
  removed         Boolean   @default(false)
  removedAt       DateTime?
  removedReason   String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Evaluation form response, when this person filled one in.
  feedback        Feedback?

  @@index([createdAt])
  @@index([attended])
  @@index([removed])
}

// Simple key/value settings so capacity and registration open/closed
// can be changed without a redeploy.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Singles Connect Hangout - Evaluation Form.
///
/// One response per phone number: re-submitting with the same number updates
/// the existing answer sheet instead of creating a second one. When the number
/// matches a registration, the response is linked to it so the admin dashboard
/// can tell who has responded.
///
/// `registrationId` is nullable: people who attended without registering (or
/// facilitators who joined late) may still send in an evaluation.
model Feedback {
  id             String        @id @default(cuid())
  registrationId String?       @unique
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  fullName String
  phone    String @unique

  // Section A - about you
  ageRange  String
  firstTime String

  // Section B - the program & the speakers
  topicsRelevance     Int
  facilitatorRating   Int
  facilitatorFriendly Int

  // Section C - the venue, the food & the timing
  duration     String
  venueComfort Int
  foodQuality  Int

  // Section D - overall & the comment
  overallScore Int
  comments     String?

  // Retired questions ---------------------------------------------------------
  // The form was cut down to ten questions in four steps, so these are no
  // longer asked. The columns stay (nullable) so the answers already collected
  // are not lost; nothing in the app reads or writes them any more.
  programRating       Int?
  engaging            Int?
  favouritePart       String?
  nextTopic           String?
  facilitatorTiming   Int?
  dateTimeConvenience Int?
  locationRating      Int?
  seating             Int?
  soundSetup          Int?
  foodTiming          Int?
  dietarySuggestions  String?
  recommendScore      Int?
  enjoyedMost         String?
  improveNext         String?

  // Thank-you SMS bookkeeping, mirrors `Registration`.
  smsStatus SmsStatus @default(PENDING)
  smsError  String?
  smsSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/// Singles Connect Hangout - Panelists' Evaluation Form.
///
/// One response per panelist: the name is folded into `panelistKey`
/// (lower-cased, spacing flattened) and re-submitting under the same name
/// updates that answer sheet instead of creating a second one.
///
/// Unlike `Feedback` there is no phone number and no SMS bookkeeping here: the
/// panelists are a known, small group who are thanked in person, and the form
/// they were given asks for their name only.
model PanelFeedback {
  id           String @id @default(cuid())
  panelistName String
  panelistKey  String @unique

  // Section A - preparation
  topicClarity  Int
  preEventComms Int

  // Section B - the discussion
  moderatorSteering  Int
  timeAdequacy       String
  questionRelevance  Int
  audienceEngagement Int

  // Section C - the big picture
  objectivesAchieved String
  overallSuccess     Int
  serveAgain         String

  // Section D - the comment
  suggestions String?

  // Retired questions ---------------------------------------------------------
  // Same story as `Feedback`: the form was cut to ten questions, so these are
  // no longer asked. The columns stay (nullable) so the answers already given
  // are not lost; nothing in the app reads or writes them any more.
  prepAdequacy        Int?
  contributionBalance Int?
  audienceQuestions   Int?
  audienceConnection  Int?
  panelDateTime       Int?
  venueSuitability    Int?
  technicalLogistics  Int?
  overallOrganization Int?
  panelistHospitality Int?
  wentWell            String?
  challenge           String?
  topicSuggestion     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
