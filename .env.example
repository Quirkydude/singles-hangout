# --- Neon Postgres ---------------------------------------------------------
# Pooled connection string (used by the app at runtime).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct / unpooled connection string (used by `prisma migrate`).
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Moolre SMS ------------------------------------------------------------
# X-API-VASKEY value from app.moolre.com
MOOLRE_API_KEY="your-vas-key"
# Registered + approved Sender ID (max 11 characters)
MOOLRE_SENDER_ID="Hangout26"

# --- Admin dashboard -------------------------------------------------------
ADMIN_PASSWORD="choose-a-strong-password"
# Random string used to sign the admin session cookie (32+ chars)
ADMIN_SESSION_SECRET="generate-a-long-random-secret"

# --- Site ------------------------------------------------------------------
# Public base URL, used for QR codes, OG images and SMS links.
SITE_URL="https://www.register.kamartec.org"

# --- Optional --------------------------------------------------------------
# Set to "true" to log SMS to the console instead of calling Moolre.
SMS_DRY_RUN="false"
