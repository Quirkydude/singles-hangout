# --- Supabase Postgres -----------------------------------------------------
# Supabase dashboard -> Connect -> ORMs -> Prisma gives you both strings.
#
# DATABASE_URL: the POOLED connection (Supavisor, "Transaction" mode, port 6543).
#   Keep the ?pgbouncer=true suffix; it disables prepared statements, which
#   transaction mode does not support.
#   Note the username is "postgres.<project-ref>", not just "postgres".
DATABASE_URL="postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# DIRECT_URL: the direct/session connection (port 5432). Used only by the
#   Prisma CLI for migrations. Replace YOUR-PASSWORD in both.
DIRECT_URL="postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: cap the connection pool per serverless instance (default 5).
# DATABASE_POOL_MAX="5"

# Optional: only if TLS fails with "self-signed certificate in certificate chain".
# DATABASE_SSL_NO_VERIFY="true"

# --- Moolre SMS ------------------------------------------------------------
# X-API-VASKEY value from app.moolre.com
MOOLRE_API_KEY="your-vas-key"
# Registered + approved Sender ID (max 11 characters)
MOOLRE_SENDER_ID="Hangout26"
# Set to "true" to log SMS to the console instead of calling Moolre.
SMS_DRY_RUN="false"

# --- Admin dashboard -------------------------------------------------------
ADMIN_PASSWORD="choose-a-strong-password"
# Random string used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="generate-a-long-random-secret"

# --- Site ------------------------------------------------------------------
# Public base URL, used for QR codes, OG images and SMS links.
# No trailing slash. Must be the real domain once deployed.
SITE_URL="https://www.register.kamartec.org"
